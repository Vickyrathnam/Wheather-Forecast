NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# OpenWeatherMap API
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# JWT Secrets
JWT_SECRET=weather_super_secret_jwt_key_2024_change_in_production
JWT_REFRESH_SECRET=weather_super_secret_refresh_key_2024_change_in_production

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/weather_forecast

# Redis
REDIS_URL=redis://localhost:6379

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# AI Engine
AI_ENGINE_URL=http://localhost:8000

# Log Level
LOG_LEVEL=info
